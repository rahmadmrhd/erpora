{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["bun"]
  },
  "include": [
    "src",
    "tools",
    "test",
    "build.ts",
    "dev.ts",
    "deps.ts",
    "csp-check.ts",
    "sbom.ts",
    "contracts-lint.ts",
    "../contracts/spectral-functions/**/*.ts"
  ]
}
