{
  "schema_version": "1",
  "key": "acme.example",
  "slug": "example",
  "name": "Example",
  "version": "1.0.0",
  "publisher": { "id": "acme", "name": "ACME" },
  "trust": "builtin",
  "compatibility": { "platform": "^0.1", "sdk": "^0.1" },
  "dependencies": [
    { "module": "platform.core", "version": "^0.1", "optional": false }
  ],
  "capabilities": ["example.ping.read", "example.notes.read"],
  "migrations": { "strategy": "versioned" },
  "i18n": { "locales": ["id", "en"], "defaultLocale": "id" },
  "offline": { "mode": "online-only" },
  "resources": [
    {
      "key": "example.note",
      "label": "Catatan",
      "actions": ["read"],
      "field_groups": [{ "key": "general", "label": "Umum", "default": true }]
    }
  ],
  "desk": {
    "label": "desk.title",
    "icon": "file-text",
    "menus": [
      { "id": "notes", "label": "nav.notes", "to": "/notes", "permission": "example.notes.read" }
    ]
  }
}
