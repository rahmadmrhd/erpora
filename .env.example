# Salin ke .env untuk pengembangan lokal. Environment proses selalu menang atas isi file ini.

# (wajib) DSN PostgreSQL.
ERP_DATABASE_URL=postgres://erp:erp@localhost:5432/erp?sslmode=disable

# development | production (default production).
ERP_ENV=development

# Alamat listen HTTP (default 127.0.0.1:8080).
ERP_HTTP_ADDR=127.0.0.1:8080

# json | text (default: text bila development, json bila production).
ERP_LOG_FORMAT=text

# Mode tenancy; saat ini hanya "single".
ERP_TENANCY_MODE=single

# (opsional) UUID tenant default; harus sama dengan tenant yang sudah tercatat di database.
# ERP_DEFAULT_TENANT_ID=

# Ambang query lambat dalam milidetik (default 200).
ERP_DB_SLOW_QUERY_MS=200

# Ambang deteksi N+1 (development saja): peringatan bila bentuk SQL yang sama berjalan > N kali dalam satu request.
# Default 10; 0 = mati.
# ERP_DB_NPLUSONE_THRESHOLD=10

# Batas waktu per statement SQL pada pool `erpora serve` (milidetik, 1000-600000). Default 30000.
# CLI (migrate, modules, command modul) tidak dibatasi.
# ERP_DB_STATEMENT_TIMEOUT_MS=30000

# Stub otorisasi sampai PRD-001: allow | deny (default allow bila ERP_ENV=development, selain itu deny).
# allow DITOLAK saat ERP_ENV=production (exit code 2) sampai autentikasi/otorisasi nyata tersedia (PRD-001).
# ERP_AUTHZ_STUB=allow

# (opsional) true mengaktifkan endpoint MUTASI /api/platform/modules di luar development (default false).
# Selama autentikasi nyata (PRD-001) belum ada, di production gunakan CLI `erpora modules`; endpoint mutasi
# tetap 404 kecuali ERP_ENV=development atau nilai ini true.
# ERP_MODULES_ADMIN_API=false

# --- OpenTelemetry (opsional) ---
# Tanpa OTEL_EXPORTER_OTLP_ENDPOINT, OpenTelemetry no-op: tidak ada exporter dan tidak ada koneksi keluar.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# http/protobuf (default) atau grpc.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Default "erpora".
# OTEL_SERVICE_NAME=erpora
# Sampler standar OTel, mis. parentbased_traceidratio.
# OTEL_TRACES_SAMPLER=parentbased_always_on
# OTEL_TRACES_SAMPLER_ARG=1.0

# Kunci penyegel rahasia diam (kunci penandatangan JWT, secret MFA, secret settings; AES-256-GCM): 32 byte acak, base64
# standar. WAJIB untuk `serve` dan command yang menyegel data (core:*), di SEMUA mode termasuk development: kosong = serve
# gagal (exit 2), tanpa kunci sementara otomatis. migrate, inspect, doctor, dan command lain tidak membutuhkannya, tetapi
# nilai yang terisi selalu divalidasi (format/panjang salah = gagal).
# Buat SEKALI per lingkungan (tidak menyimpan apa pun): task erpora -- secret:generate   (setara: openssl rand -base64 32)
# Cadangkan terpisah dari backup database; kehilangan kunci = data tersegel tidak terbaca. Jangan di-commit.
ERP_SECRET_KEY=

# (opsional) Kunci LAMA saat rotasi: hanya untuk membuka data yang tersegel sebelum rotasi (id kunci pada header segel
# memilih kunci). Isi dengan nilai ERP_SECRET_KEY sebelumnya, ganti ERP_SECRET_KEY dengan kunci baru; lepas setelah
# semua data disegel ulang. Tidak boleh sama dengan ERP_SECRET_KEY.
# ERP_SECRET_KEY_PREVIOUS=

# Parameter hash sandi argon2id (PRD-001 FR-101). Kosong = default OWASP Password Storage Cheat Sheet (konfigurasi minimum
# argon2id): m=19456 KiB (19 MiB), t=2, p=1. Batas yang diterima: memori 19456..262144 KiB, time 1..10 (time=1 hanya bila
# memori >= 47104 KiB = 46 MiB, setara OWASP), parallelism 1..16; di luar itu `erpora` gagal start (exit 2). Menaikkan nilai
# tidak membatalkan hash lama: login berikutnya yang sandinya benar menyimpan ulang hash dengan parameter baru. Memori
# dipakai PER hash yang sedang berjalan; naikkan dengan memperhitungkan jumlah login serentak.
# ERP_ARGON2_MEMORY_KIB=19456
# ERP_ARGON2_TIME=2
# ERP_ARGON2_PARALLELISM=1

# Batas hash argon2id yang berjalan SERENTAK dalam satu proses (Hash, Verify, dan verifikasi tiruan untuk email tak
# dikenal). Login serentak melebihi batas menunggu sebentar lalu dijawab 429 rate_limited + Retry-After (tidak membedakan
# email ada atau tidak). Bilangan bulat 1..64; kosong = min(jumlah CPU/GOMAXPROCS, 4), minimal 1. Memori terburuk =
# batas x ERP_ARGON2_MEMORY_KIB (default 4 x 19 MiB, sekitar 76 MiB); turunkan bila RAM sempit, naikkan hanya bila CPU
# banyak dan login serentak memang tinggi.
# ERP_ARGON2_MAX_CONCURRENT=4

# --- Surat (FR-108, K-C1.6: env sementara sampai Settings C3) ---
# Driver: log (bawaan di development; tidak mengirim apa pun, hanya mencatat penerima tersamar + subjek; isi surat penuh
# dicatat HANYA bila ERP_ENV=development) | smtp. DI PRODUCTION variabel ini WAJIB diisi untuk `serve` (fail-closed):
# smtp agar surat terkirim, atau log hanya bila sengaja tidak mengirim surat (reset sandi lewat email tidak berfungsi).
# URL publik aplikasi untuk tautan di email diatur di settings platform, bukan di env.
# ERP_MAIL_DRIVER=log
# Wajib bila ERP_MAIL_DRIVER=smtp: host (tanpa skema/port) dan alamat pengirim polos.
# ERP_SMTP_HOST=smtp.example.com
# ERP_SMTP_FROM=noreply@example.com
# Port bawaan: 587 (starttls), 465 (tls), 25 (none).
# ERP_SMTP_PORT=587
# Autentikasi (PLAIN/LOGIN) hanya di atas TLS; isi username dan sandi bersama. Sandi tidak dipotong spasinya dan
# disamarkan di log dan `erpora inspect config`.
# ERP_SMTP_USERNAME=
# ERP_SMTP_PASSWORD=
# starttls (bawaan; STARTTLS wajib, tanpa downgrade) | tls (TLS implisit) | none (hanya development, tanpa autentikasi;
# ditolak saat ERP_ENV=production). Sertifikat server selalu diverifikasi.
# ERP_SMTP_TLS_MODE=starttls

# --- Reverse proxy (PRD-001 Q26) ---
# Daftar IP/CIDR proxy tepercaya, dipisah koma (mis. 10.0.0.0/8,192.0.2.5). WAJIB diisi bila aplikasi berjalan di belakang
# reverse proxy/load balancer: batas laju per IP dan lockout per (akun, IP) memakai IP klien, dan tanpa ini semua klien
# tampak berasal dari IP proxy. Bila peer TCP ada di daftar, X-Forwarded-For dibaca dari kanan ke kiri dan hop pertama
# yang bukan proxy tepercaya menjadi IP klien. Kosong (bawaan) = X-Forwarded-For diabaikan (tidak dapat dipalsukan).
# Maks. 64 entri; tanpa /0, hostname, atau port; X-Real-IP tidak dipakai.
# ERP_TRUSTED_PROXIES=
