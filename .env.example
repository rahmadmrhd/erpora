# Salin ke .env untuk pengembangan lokal. Environment proses selalu menang atas isi file ini.

# (wajib) DSN PostgreSQL.
ERP_DATABASE_URL=postgres://erp:erp@localhost:5432/erp?sslmode=disable

# development | production (default production).
ERP_ENV=development

# Alamat listen HTTP (default 127.0.0.1:8080).
ERP_HTTP_ADDR=127.0.0.1:8080

# json | text (default: text bila development, json bila production).
ERP_LOG_FORMAT=text

# Mode tenancy; saat ini hanya "single".
ERP_TENANCY_MODE=single

# (opsional) UUID tenant default; harus sama dengan tenant yang sudah tercatat di database.
# ERP_DEFAULT_TENANT_ID=

# Ambang query lambat dalam milidetik (default 200).
ERP_DB_SLOW_QUERY_MS=200
