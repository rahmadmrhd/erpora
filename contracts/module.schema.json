{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erpora.dev/contracts/module.schema.json",
  "title": "ERPora module manifest (module.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key",
    "slug",
    "name",
    "version",
    "publisher",
    "trust",
    "compatibility",
    "dependencies",
    "capabilities",
    "migrations",
    "offline"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "trust": { "enum": ["builtin", "verified", "untrusted"] },
    "required": { "type": "boolean" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "sdk"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "version", "optional"],
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "version": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "provides": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["versioned", "none"] }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["online-only", "offline-read", "offline-draft", "offline-write"]
        }
      }
    },
    "i18n": {
      "type": "object",
      "description": "PRD-000 FR-25: katalog terjemahan modul (namespace = slug). Opsional; modul tanpa bagian ini tidak punya namespace.",
      "additionalProperties": false,
      "required": ["locales", "defaultLocale"],
      "properties": {
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }
        },
        "defaultLocale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }
      }
    },
    "desk": {
      "type": "object",
      "description": "Revisi M3a (Q40 butir 10-13): Desk modul. label/icon/menu dibaca server untuk menyusun daftar Desk per pengguna (GET /api/platform/desks); Dashboard dibangkitkan platform dan tidak boleh dideklarasikan. Opsional di schema; module:check mewajibkannya untuk modul berdirektori web/.",
      "additionalProperties": false,
      "required": ["label", "icon", "menus"],
      "properties": {
        "label": { "$ref": "#/$defs/messageKey" },
        "icon": { "$ref": "#/$defs/iconName" },
        "dashboard": {
          "type": "object",
          "description": "Label dan ikon item Dashboard bawaan Desk; bila tidak diisi platform memakai label dan ikon bawaan.",
          "additionalProperties": false,
          "properties": {
            "label": { "$ref": "#/$defs/messageKey" },
            "icon": { "$ref": "#/$defs/iconName" }
          }
        },
        "menus": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/deskMenu" }
        },
        "settings": { "type": "object", "description": "Pengaturan Desk; isi diperketat kemudian." }
      }
    },
    "artifact": { "type": "string", "description": "Marketplace: lokasi artefak modul." },
    "checksum": { "type": "string", "description": "Marketplace: checksum artefak." },
    "signature": { "type": "string", "description": "Marketplace: tanda tangan artefak." },
    "requested_permissions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Marketplace: izin yang diminta modul."
    },
    "license": { "type": "string", "description": "Marketplace: lisensi modul." },
    "resources": {
      "type": "array",
      "description": "PRD-001 FR-110: resource dan aksi permission modul. Hanya field_groups[].classification yang divalidasi (security-guidelines §2); isi lain diperketat kemudian.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "field_groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["key"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                "fields": { "type": "array", "items": { "type": "string" } },
                "classification": {
                  "enum": ["public", "internal", "confidential", "highly_confidential"],
                  "description": "Klasifikasi data field group (security-guidelines §2, PRD-001 FR-110)."
                }
              }
            }
          }
        }
      }
    },
    "scope_dimensions": {
      "type": "array",
      "description": "PRD-001 FR-110: dimensi scope modul. Isi diperketat kemudian."
    },
    "default_roles": {
      "type": "array",
      "description": "PRD-001 FR-110: role bawaan modul. Isi diperketat kemudian."
    },
    "settings": {
      "type": "object",
      "description": "PRD-001 FR-120: definisi setting modul. Isi diperketat kemudian."
    }
  },
  "$defs": {
    "messageKey": {
      "type": "string",
      "description": "Kunci i18n bertitik pada katalog namespace modul (mis. nav.notes).",
      "pattern": "^[a-z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_-]+)+$"
    },
    "iconName": {
      "type": "string",
      "description": "Nama ikon dari peta ikon platform.",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "deskMenuId": {
      "type": "string",
      "description": "Id menu, unik dalam satu Desk (item, grup, dan anak grup).",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "deskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "to", "permission"],
      "properties": {
        "id": { "$ref": "#/$defs/deskMenuId" },
        "label": { "$ref": "#/$defs/messageKey" },
        "icon": { "$ref": "#/$defs/iconName" },
        "to": {
          "type": "string",
          "description": "Path internal relatif base route modul (/notes); tanpa skema, host, //, query, atau fragmen.",
          "pattern": "^/([A-Za-z0-9._~%-]+(/[A-Za-z0-9._~%-]+)*)?$",
          "maxLength": 200
        },
        "permission": { "type": "string", "minLength": 1, "description": "Salah satu capabilities modul; item disembunyikan bila pengguna tidak memilikinya." }
      }
    },
    "deskGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/deskMenuId" },
        "label": { "$ref": "#/$defs/messageKey" },
        "icon": { "$ref": "#/$defs/iconName" },
        "children": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/deskItem" } }
      }
    },
    "deskMenu": {
      "description": "Item menu atau grup satu tingkat (grup tidak boleh bersarang).",
      "oneOf": [{ "$ref": "#/$defs/deskItem" }, { "$ref": "#/$defs/deskGroup" }]
    }
  }
}
