{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erpora.dev/contracts/module.schema.json",
  "title": "ERPora module manifest (module.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key",
    "slug",
    "name",
    "version",
    "publisher",
    "trust",
    "compatibility",
    "dependencies",
    "capabilities",
    "migrations",
    "offline"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "trust": { "enum": ["builtin", "verified", "untrusted"] },
    "required": { "type": "boolean" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "sdk"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "version", "optional"],
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "version": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "provides": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["versioned", "none"] }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["online-only", "offline-read", "offline-draft", "offline-write"]
        }
      }
    },
    "i18n": {
      "type": "object",
      "description": "PRD-000 FR-25: katalog terjemahan modul (namespace = slug). Opsional; modul tanpa bagian ini tidak punya namespace.",
      "additionalProperties": false,
      "required": ["locales", "defaultLocale"],
      "properties": {
        "locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }
        },
        "defaultLocale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" }
      }
    },
    "desk": {
      "type": "object",
      "description": "Revisi M3a (Q40 butir 10-13): Desk modul. label/icon/menu dibaca server untuk menyusun daftar Desk per pengguna (GET /api/platform/desks); Dashboard dibangkitkan platform dan tidak boleh dideklarasikan. Opsional di schema; module:check mewajibkannya untuk modul berdirektori web/.",
      "additionalProperties": false,
      "required": ["label", "icon", "menus"],
      "properties": {
        "label": { "$ref": "#/$defs/messageKey" },
        "icon": { "$ref": "#/$defs/iconName" },
        "dashboard": {
          "type": "object",
          "description": "Label dan ikon item Dashboard bawaan Desk; bila tidak diisi platform memakai label dan ikon bawaan.",
          "additionalProperties": false,
          "properties": {
            "label": { "$ref": "#/$defs/messageKey" },
            "icon": { "$ref": "#/$defs/iconName" }
          }
        },
        "menus": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/deskMenu" }
        },
        "settings": { "type": "object", "description": "Pengaturan Desk; isi diperketat kemudian." }
      }
    },
    "artifact": { "type": "string", "description": "Marketplace: lokasi artefak modul." },
    "checksum": { "type": "string", "description": "Marketplace: checksum artefak." },
    "signature": { "type": "string", "description": "Marketplace: tanda tangan artefak." },
    "requested_permissions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Marketplace: izin yang diminta modul."
    },
    "license": { "type": "string", "description": "Marketplace: lisensi modul." },
    "resources": {
      "type": "array",
      "description": "PRD-001 FR-110: resource dan aksi permission modul. Permission diturunkan sebagai <key>.<aksi>; label berupa kunci i18n (Q40). Aturan lintas-field (aksi standar, grup default, dimensi) diperiksa registry dan module:check.",
      "items": { "$ref": "#/$defs/resource" }
    },
    "scope_dimensions": {
      "type": "array",
      "description": "PRD-001 FR-110: dimensi scope modul (mis. gudang).",
      "items": { "$ref": "#/$defs/scopeDimension" }
    },
    "default_roles": {
      "type": "array",
      "description": "PRD-001 FR-110, FR-113: role bawaan modul beserta matriks awalnya.",
      "items": { "$ref": "#/$defs/defaultRole" }
    },
    "settings": {
      "type": "object",
      "description": "PRD-001 FR-120: definisi setting modul. Isi diperketat kemudian."
    }
  },
  "$defs": {
    "resourceKey": {
      "type": "string",
      "description": "Kunci resource, dimensi, atau role: <slug>.<nama_snake> (awalan slug diperiksa registry).",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9_]*$"
    },
    "fieldName": {
      "type": "string",
      "description": "Nama field resource (snake_case).",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "actionKey": {
      "type": "string",
      "description": "Kunci aksi: aksi standar PRD-001 FR-110 atau aksi kustom ^[a-z_]+$ (keanggotaan diperiksa registry).",
      "pattern": "^[a-z_]+$"
    },
    "scopeToken": {
      "type": "string",
      "description": "Kondisi scope: all, owner, assigned:<dimensi>, atau custom:<key> (PRD-001 FR-111).",
      "pattern": "^(all|owner|assigned:[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9_]*|custom:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*)$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "actions", "field_groups"],
      "properties": {
        "key": { "$ref": "#/$defs/resourceKey" },
        "label": { "$ref": "#/$defs/messageKey" },
        "actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/actionKey" } },
        "custom_actions": { "type": "array", "items": { "$ref": "#/$defs/customAction" } },
        "owner_field": { "$ref": "#/$defs/fieldName" },
        "scope_fields": {
          "type": "object",
          "description": "Dimensi scope (kunci dimensi) menuju nama field resource.",
          "propertyNames": { "$ref": "#/$defs/resourceKey" },
          "additionalProperties": { "$ref": "#/$defs/fieldName" }
        },
        "field_groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fieldGroup" } },
        "audit": {
          "type": "object",
          "description": "PRD-001 FR-131: hanya disimpan.",
          "additionalProperties": false,
          "properties": { "data_changes": { "type": "boolean" } }
        }
      }
    },
    "customAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/actionKey" },
        "label": { "$ref": "#/$defs/messageKey" }
      }
    },
    "fieldGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "$ref": "#/$defs/messageKey" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/fieldName" } },
        "classification": {
          "enum": ["public", "internal", "confidential", "highly_confidential"],
          "description": "Klasifikasi data field group (security-guidelines §2, PRD-001 FR-110)."
        },
        "default": { "type": "boolean" },
        "sensitive": { "type": "boolean", "description": "PRD-001 FR-131: hanya disimpan." }
      }
    },
    "scopeDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "$ref": "#/$defs/resourceKey" },
        "label": { "$ref": "#/$defs/messageKey" },
        "source": { "$ref": "#/$defs/resourceKey", "description": "Sumber nilai dimensi untuk pemilih penugasan (K-C2.3); kosong = key." }
      }
    },
    "defaultRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "permissions"],
      "properties": {
        "key": { "$ref": "#/$defs/resourceKey" },
        "label": { "$ref": "#/$defs/messageKey" },
        "permissions": { "type": "array", "items": { "$ref": "#/$defs/roleRow" } },
        "field_access": { "type": "array", "items": { "$ref": "#/$defs/roleFieldAccess" } }
      }
    },
    "roleRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "actions", "scope"],
      "properties": {
        "resource": { "$ref": "#/$defs/resourceKey" },
        "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/actionKey" } },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Daftar kondisi digabung AND; daftar kosong tidak sah (PRD-001 FR-111).",
          "items": { "$ref": "#/$defs/scopeToken" }
        }
      }
    },
    "roleFieldAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "field_group", "access"],
      "properties": {
        "resource": { "$ref": "#/$defs/resourceKey" },
        "field_group": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "access": { "enum": ["none", "read", "write"] }
      }
    },
    "messageKey": {
      "type": "string",
      "description": "Kunci i18n bertitik pada katalog namespace modul (mis. nav.notes).",
      "pattern": "^[a-z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_-]+)+$"
    },
    "iconName": {
      "type": "string",
      "description": "Nama ikon dari peta ikon platform.",
      "pattern": "^[a-z0-9-]{1,40}$"
    },
    "deskMenuId": {
      "type": "string",
      "description": "Id menu, unik dalam satu Desk (item, grup, dan anak grup).",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "deskItem": {
      "description": "Item menu: tepat satu dari permission atau access (PRD-000 Q43).",
      "oneOf": [{ "$ref": "#/$defs/deskPermissionItem" }, { "$ref": "#/$defs/deskAccessItem" }]
    },
    "deskPermissionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "to", "permission"],
      "properties": {
        "id": { "$ref": "#/$defs/deskMenuId" },
        "label": { "$ref": "#/$defs/messageKey" },
        "icon": { "$ref": "#/$defs/iconName" },
        "to": {
          "type": "string",
          "description": "Path internal relatif base route modul (/notes); tanpa skema, host, //, query, atau fragmen.",
          "pattern": "^/([A-Za-z0-9._~%-]+(/[A-Za-z0-9._~%-]+)*)?$",
          "maxLength": 200
        },
        "permission": { "type": "string", "minLength": 1, "description": "Salah satu capabilities modul; item disembunyikan bila pengguna tidak memilikinya." }
      }
    },
    "deskAccessItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "to", "access"],
      "properties": {
        "id": { "$ref": "#/$defs/deskMenuId" },
        "label": { "$ref": "#/$defs/messageKey" },
        "icon": { "$ref": "#/$defs/iconName" },
        "to": {
          "type": "string",
          "description": "Path internal relatif base route modul (/notes); tanpa skema, host, //, query, atau fragmen.",
          "pattern": "^/([A-Za-z0-9._~%-]+(/[A-Za-z0-9._~%-]+)*)?$",
          "maxLength": 200
        },
        "access": { "enum": ["authenticated"], "description": "Pengganti eksplisit permission: item terlihat bagi setiap pengguna yang login (PRD-000 Q43). Tidak boleh bersama permission." }
      }
    },
    "deskGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/deskMenuId" },
        "label": { "$ref": "#/$defs/messageKey" },
        "icon": { "$ref": "#/$defs/iconName" },
        "children": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/deskItem" } }
      }
    },
    "deskMenu": {
      "description": "Item menu atau grup satu tingkat (grup tidak boleh bersarang).",
      "oneOf": [{ "$ref": "#/$defs/deskItem" }, { "$ref": "#/$defs/deskGroup" }]
    }
  }
}
