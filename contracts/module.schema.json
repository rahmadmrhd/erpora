{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erpora.dev/contracts/module.schema.json",
  "title": "ERPora module manifest (module.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "key",
    "slug",
    "name",
    "version",
    "publisher",
    "trust",
    "compatibility",
    "dependencies",
    "capabilities",
    "migrations",
    "offline"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*\\.[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "trust": { "enum": ["builtin", "verified", "untrusted"] },
    "required": { "type": "boolean" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "sdk"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "version", "optional"],
        "properties": {
          "module": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9_]*)+$"
      }
    },
    "provides": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["versioned", "none"] }
      }
    },
    "offline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["online-only", "offline-read", "offline-draft", "offline-write"]
        }
      }
    },
    "artifact": { "type": "string", "description": "Marketplace: lokasi artefak modul." },
    "checksum": { "type": "string", "description": "Marketplace: checksum artefak." },
    "signature": { "type": "string", "description": "Marketplace: tanda tangan artefak." },
    "requested_permissions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Marketplace: izin yang diminta modul."
    },
    "license": { "type": "string", "description": "Marketplace: lisensi modul." },
    "resources": {
      "type": "array",
      "description": "PRD-001 FR-110: resource dan aksi permission modul. Isi diperketat kemudian."
    },
    "scope_dimensions": {
      "type": "array",
      "description": "PRD-001 FR-110: dimensi scope modul. Isi diperketat kemudian."
    },
    "default_roles": {
      "type": "array",
      "description": "PRD-001 FR-110: role bawaan modul. Isi diperketat kemudian."
    },
    "settings": {
      "type": "object",
      "description": "PRD-001 FR-120: definisi setting modul. Isi diperketat kemudian."
    }
  }
}
