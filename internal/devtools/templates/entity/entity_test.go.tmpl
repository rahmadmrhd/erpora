package domain

import (
	"errors"
	"strings"
	"testing"
)

func TestNew[[.T.Pascal]](t *testing.T) {
	cases := []struct {
		name    string
		title   string
		wantErr bool
	}{
		{"kosong", "", true},
		{"hanya spasi", "   ", true},
		{"201 karakter", strings.Repeat("a", 201), true},
		{"1 karakter", "a", false},
		{"200 karakter", strings.Repeat("a", 200), false},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			e, err := New[[.T.Pascal]](tc.title)
			if (err != nil) != tc.wantErr {
				t.Fatalf("err = %v, wantErr %v", err, tc.wantErr)
			}
			if tc.wantErr && !errors.Is(err, ErrInvalid[[.T.Pascal]]Title) {
				t.Errorf("err = %v, want ErrInvalid[[.T.Pascal]]Title", err)
			}
			if err == nil && e.Title != tc.title {
				t.Errorf("Title = %q", e.Title)
			}
		})
	}
}
