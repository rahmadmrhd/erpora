package httpapi

import (
	"context"
	"errors"
	"fmt"
	"net/http"

	"github.com/google/uuid"

	"[[.Mod.GoPath]]/internal/domain"
	"erpora/sdk/httpx"
)

// [[.Name]]Request adalah body opsional [[.Method]] [[.Path]]. httpx.DecodeJSON menolak field tak dikenal dan tipe salah (422).
type [[.Name]]Request struct {
	Reason string `json:"reason"`
}

// [[.Name]]Data adalah DTO respons (api-guidelines §4).
type [[.Name]]Data struct {
	ID        string `json:"id"`
	Title     string `json:"title"`
	Version   int64  `json:"version"`
	CreatedAt string `json:"createdAt"`
	UpdatedAt string `json:"updatedAt"`
}

var err[[.Name]]NotImplemented = errors.New("[[.Name]] belum disambungkan ke use case")

// [[.Camel]]Func adalah titik sambung use case; ifMatch dan idempotencyKey adalah nilai header If-Match dan Idempotency-Key
// (kosong = tidak dikirim; aksi WAJIB idempoten terhadap Idempotency-Key, api-guidelines §7.2). Ganti dengan
// pemanggilan use case di application/. Use case WAJIB membatasi record ke scope pemanggil (domain.ErrNotFound bila di
// luar scope), memeriksa ifMatch terhadap Version (412 version_mismatch lewat *httpx.Error), dan menolak transisi yang tidak
// sah (409 invalid_state lewat *httpx.Error).
var [[.Camel]]Func = default[[.Name]]

// default[[.Name]] adalah titik sambung bawaan kerangka: 501 sampai use case disambungkan. Test IDOR hasil generate
// gagal bila [[.Camel]]Func sudah bukan fungsi ini (lihat Test[[.Name]]_IDOR_*).
func default[[.Name]](_ context.Context, _, _, _ string, _ [[.Name]]Request) ([[.Name]]Data, error) {
	return [[.Name]]Data{}, err[[.Name]]NotImplemented
}

// [[.Name]] melayani [[.Method]] [[.Path]]: aksi pada satu record (api-guidelines §2: POST .../{id}/<aksi>).
func [[.Name]]() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		id := r.PathValue("id")
		if _, err := uuid.Parse(id); err != nil { // ID rusak = tidak ada; jangan bedakan dari record di luar scope
			httpx.WriteError(w, r, http.StatusNotFound, "not_found", "Data tidak ditemukan.", nil)
			return
		}
		req, err := [[.Decode]](w, r, httpx.AllowEmptyBody())
		if err != nil {
			httpx.RespondError(w, r, err)
			return
		}
		out, err := [[.Camel]]Func(r.Context(), id, r.Header.Get("If-Match"), r.Header.Get("Idempotency-Key"), req)
		switch {
		case err == nil:
			httpx.WriteData(w, http.StatusOK, out)
		case errors.Is(err, domain.ErrNotFound):
			httpx.WriteError(w, r, http.StatusNotFound, "not_found", "Data tidak ditemukan.", nil)
		case errors.Is(err, err[[.Name]]NotImplemented):
			httpx.WriteError(w, r, http.StatusNotImplemented, "not_implemented", "Endpoint belum diimplementasi.", nil)
		default:
			httpx.RespondError(w, r, fmt.Errorf("[[.Name]]: %w", err))
		}
	})
}
