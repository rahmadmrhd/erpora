package httpapi

import (
	"context"
	"errors"
	"fmt"
	"net/http"

	"[[.Mod.GoPath]]/internal/application"
	"erpora/sdk/httpx"
)

// [[.Name]]Data adalah DTO satu elemen respons [[.Method]] [[.Path]] (api-guidelines §4).
type [[.Name]]Data struct {
	ID        string `json:"id"`
	Title     string `json:"title"`
	Version   int64  `json:"version"`
	CreatedAt string `json:"createdAt"`
	UpdatedAt string `json:"updatedAt"`
}

var err[[.Name]]NotImplemented = errors.New("[[.Name]] belum disambungkan ke use case")

// [[.Camel]]Func adalah titik sambung use case (page mulai 1). Ganti dengan pemanggilan use case di application/.
// Use case WAJIB membatasi hasil ke scope pemanggil (sdk/authz.Filter setelah PRD-001).
var [[.Camel]]Func = default[[.Name]]

// default[[.Name]] adalah titik sambung bawaan kerangka: 501 sampai use case disambungkan.
// (test NotImplementedByDefault memeriksanya).
func default[[.Name]](_ context.Context, _, _ int) ([][[.Name]]Data, int64, error) {
	return nil, 0, err[[.Name]]NotImplemented
}

// [[.Name]] melayani [[.Method]] [[.Path]]: daftar berpagination halaman (api-guidelines §6).
func [[.Name]]() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		page, ok := intParam(r, "page", 1, 1, 1<<30)
		if !ok {
			badParam(w, r, "page", "parameter page harus bilangan bulat >= 1")
			return
		}
		size, ok := intParam(r, "pageSize", application.DefaultPageSize, 1, application.MaxPageSize)
		if !ok {
			badParam(w, r, "pageSize", "parameter pageSize harus bilangan bulat 1 sampai 200")
			return
		}
		items, total, err := [[.Camel]]Func(r.Context(), page, size)
		switch {
		case err == nil:
			if items == nil {
				items = [][[.Name]]Data{} // data selalu array, tidak pernah null
			}
			httpx.WritePage(w, http.StatusOK, items, httpx.Page{
				Page: page, PageSize: size, Total: total, HasMore: int64(page)*int64(size) < total,
			})
		case errors.Is(err, err[[.Name]]NotImplemented):
			httpx.WriteError(w, r, http.StatusNotImplemented, "not_implemented", "Endpoint belum diimplementasi.", nil)
		default:
			httpx.RespondError(w, r, fmt.Errorf("[[.Name]]: %w", err))
		}
	})
}
