package httpapi

import (
	"context"
	"errors"
	"fmt"
	"net/http"

	"erpora/sdk/httpx"
)

// [[.Name]]Request adalah body [[.Method]] [[.Path]]. httpx.DecodeJSON menolak field tak dikenal dan tipe salah (422).
type [[.Name]]Request struct {
	Title string `json:"title"`
}

// [[.Name]]Data adalah DTO respons (api-guidelines §4).
type [[.Name]]Data struct {
	ID        string `json:"id"`
	Title     string `json:"title"`
	Version   int64  `json:"version"`
	CreatedAt string `json:"createdAt"`
	UpdatedAt string `json:"updatedAt"`
}

var err[[.Name]]NotImplemented = errors.New("[[.Name]] belum disambungkan ke use case")

// [[.Camel]]Func adalah titik sambung use case. Ganti dengan pemanggilan use case di application/. Pembuatan resource
// WAJIB idempoten terhadap header Idempotency-Key (api-guidelines §7.2) dan memberi Version 1.
var [[.Camel]]Func = func(_ context.Context, _ [[.Name]]Request) ([[.Name]]Data, error) {
	return [[.Name]]Data{}, err[[.Name]]NotImplemented
}

// [[.Name]] melayani [[.Method]] [[.Path]]: 201 + Location (api-guidelines §7).
func [[.Name]]() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		req, err := [[.Decode]](w, r)
		if err != nil {
			httpx.RespondError(w, r, err)
			return
		}
		out, err := [[.Camel]]Func(r.Context(), req)
		switch {
		case err == nil:
			w.Header().Set("Location", "[[.BasePath]][[.Path]]/"+out.ID)
			httpx.WriteData(w, http.StatusCreated, out)
		case errors.Is(err, err[[.Name]]NotImplemented):
			httpx.WriteError(w, r, http.StatusNotImplemented, "not_implemented", "Endpoint belum diimplementasi.", nil)
		default:
			// Kesalahan validasi domain: kembalikan *httpx.Error 422 dari use case; selain itu 500 generik.
			httpx.RespondError(w, r, fmt.Errorf("[[.Name]]: %w", err))
		}
	})
}
