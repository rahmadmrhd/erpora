// Test IDOR (CLAUDE.md, PRD-001 FR-119): principal lain tidak boleh melihat atau mengubah record milik pemilik; jawabannya
// 404 not_found (bukan 403) tanpa membocorkan isi record. Kerangka ini memakai "principal" palsu di context; setelah
// sdk/authz.Check/authz.Filter tersedia, ganti dengan dua principal sungguhan (user A vs user B) dan pertahankan asersinya.
func Test[[.Name]]_IDOR_OtherPrincipalGets404(t *testing.T) {
	if ![[.Camel]]IsDefault() {
		t.Fatal("[[.Camel]]Func sudah disambungkan ke use case sungguhan, sedangkan test IDOR kerangka ini memakai stub (principal palsu) yang menimpa titik sambung dan tetap hijau walau pembatasan scope di use case hilang. Tulis ulang test ini terhadap use case sungguhan di atas repository yang menolak record milik principal lain (dua principal: A vs B), lalu hapus pemeriksaan ini.")
	}
	[[.Camel]]Restore(t)
	[[if eq .Kind "get_item"]][[.Camel]]Func = func(ctx context.Context, id string) ([[.Name]]Data, error) {
		if ctx.Value([[.Camel]]PrincipalKey{}) != "owner" {
			return [[.Name]]Data{}, domain.ErrNotFound
		}
		return [[.Name]]Data{ID: id, Title: "rahasia-pemilik", Version: 1}, nil
	}[[end]][[if eq .Kind "post_action"]][[.Camel]]Func = func(ctx context.Context, id, _, _ string, _ [[.Name]]Request) ([[.Name]]Data, error) {
		if ctx.Value([[.Camel]]PrincipalKey{}) != "owner" {
			return [[.Name]]Data{}, domain.ErrNotFound
		}
		return [[.Name]]Data{ID: id, Title: "rahasia-pemilik", Version: 2}, nil
	}[[end]][[if eq .Kind "patch"]][[.Camel]]Func = func(ctx context.Context, id, _ string, _ [[.Name]]Request) ([[.Name]]Data, error) {
		if ctx.Value([[.Camel]]PrincipalKey{}) != "owner" {
			return [[.Name]]Data{}, domain.ErrNotFound
		}
		return [[.Name]]Data{ID: id, Title: "rahasia-pemilik", Version: 2}, nil
	}[[end]][[if eq .Kind "delete"]][[.Camel]]Func = func(ctx context.Context, _, _ string) error {
		if ctx.Value([[.Camel]]PrincipalKey{}) != "owner" {
			return domain.ErrNotFound
		}
		return nil
	}[[end]]

	intruder := [[.Camel]]Do("intruder", [[.Camel]]SampleID, [[if .HasBody]][[.Camel]]Body[[else]]""[[end]])
	if intruder.Code != http.StatusNotFound || errCode(t, intruder) != "not_found" {
		t.Fatalf("principal lain: %d %s, want 404 not_found", intruder.Code, intruder.Body.String())
	}
	if strings.Contains(intruder.Body.String(), "rahasia-pemilik") {
		t.Errorf("isi record bocor ke principal lain: %s", intruder.Body.String())
	}
	owner := [[.Camel]]Do("owner", [[.Camel]]SampleID, [[if .HasBody]][[.Camel]]Body[[else]]""[[end]])
	if owner.Code != [[.SuccessCode]] {
		t.Fatalf("pemilik: %d %s, want [[.SuccessCode]]", owner.Code, owner.Body.String())
	}
}

[[end]][[if eq .Kind "get_collection"]]func Test[[.Name]]_ListsAndPaginates(t *testing.T) {
	[[.Camel]]Restore(t)
	var gotPage, gotSize int
	[[.Camel]]Func = func(_ context.Context, page, size int) ([][[.Name]]Data, int64, error) {
		gotPage, gotSize = page, size
		return [][[.Name]]Data{{ID: [[.Camel]]SampleID, Title: "a", Version: 1}}, 60, nil
	}
	rec := [[.Camel]]Do("owner", "", "")
	if rec.Code != http.StatusOK || gotPage != 1 || gotSize != 25 {
		t.Fatalf("%d page=%d size=%d %s", rec.Code, gotPage, gotSize, rec.Body.String())
	}
	if !strings.Contains(rec.Body.String(), `"hasMore":true`) {
		t.Errorf("page = %s", rec.Body.String())
	}
}

func Test[[.Name]]_InvalidParams(t *testing.T) {
	for _, q := range []string{"page=0", "pageSize=201", "pageSize=abc"} {
		mux := http.NewServeMux()
		mux.Handle("[[.Method]] [[.Path]]", [[.Name]]())
		rec := httptest.NewRecorder()
		mux.ServeHTTP(rec, httptest.NewRequest("[[.Method]]", "[[.Path]]?"+q, nil))
		if rec.Code != http.StatusBadRequest || errCode(t, rec) != "bad_request" {
			t.Errorf("%s: %d %s", q, rec.Code, rec.Body.String())
		}
	}
}

