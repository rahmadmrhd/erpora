// [[.Camel]]PrincipalKey membawa "principal" uji lewat context; menggantikan sdk/authz sampai PRD-001 tersedia.
type [[.Camel]]PrincipalKey struct{}

const [[.Camel]]SampleID = "0190a1b2-c3d4-7e5f-8a9b-0c1d2e3f4a5b"

// [[.Camel]]Do mengirim request ke handler lewat ServeMux (agar r.PathValue terisi) sebagai principal tertentu.
func [[.Camel]]Do(principal, id, body string) *httptest.ResponseRecorder {
	mux := http.NewServeMux()
	mux.Handle("[[.Method]] [[.Path]]", [[.Name]]())
	target := strings.ReplaceAll("[[.Path]]", "{id}", id)
	req := httptest.NewRequest("[[.Method]]", target, strings.NewReader(body))
	if body != "" {
		req.Header.Set("Content-Type", "application/json")
	}
	if principal != "" {
		req = req.WithContext(context.WithValue(req.Context(), [[.Camel]]PrincipalKey{}, principal))
	}
	rec := httptest.NewRecorder()
	mux.ServeHTTP(rec, req)
	return rec
}

[[if .HasBody]]const [[.Camel]]Body = `[[.SampleBody]]`

[[end]]// [[.Camel]]Restore mengembalikan titik sambung use case setelah test.
func [[.Camel]]Restore(t *testing.T) {
	t.Helper()
	orig := [[.Camel]]Func
	t.Cleanup(func() { [[.Camel]]Func = orig })
}

[[if .HasID]]// [[.Camel]]IsDefault melaporkan apakah titik sambung masih fungsi bawaan kerangka (501).
func [[.Camel]]IsDefault() bool {
	return reflect.ValueOf([[.Camel]]Func).Pointer() == reflect.ValueOf(default[[.Name]]).Pointer()
}
[[end]]
// Kerangka belum disambungkan ke use case: harus menjawab 501, bukan panik atau 200 palsu.
func Test[[.Name]]_NotImplementedByDefault(t *testing.T) {
	rec := [[.Camel]]Do("owner", [[.Camel]]SampleID, [[if .HasBody]][[.Camel]]Body[[else]]""[[end]])
	if rec.Code != http.StatusNotImplemented || errCode(t, rec) != "not_implemented" {
		t.Fatalf("%d %s", rec.Code, rec.Body.String())
	}
}

[[if .HasID]]// ID yang bukan UUID dijawab 404 (tidak dibedakan dari record di luar scope).
