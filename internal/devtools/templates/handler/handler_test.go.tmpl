[[end]][[if eq .Kind "post_create"]]func Test[[.Name]]_CreatesWithLocation(t *testing.T) {
	[[.Camel]]Restore(t)
	[[.Camel]]Func = func(_ context.Context, _ string, req [[.Name]]Request) ([[.Name]]Data, error) {
		return [[.Name]]Data{ID: [[.Camel]]SampleID, Title: req.Title, Version: 1}, nil
	}
	rec := [[.Camel]]Do("owner", "", [[.Camel]]Body)
	if rec.Code != http.StatusCreated {
		t.Fatalf("%d %s", rec.Code, rec.Body.String())
	}
	if got := rec.Header().Get("Location"); got != "[[.BasePath]][[.Path]]/"+[[.Camel]]SampleID {
		t.Errorf("Location = %q", got)
	}
}

[[end]][[if or (eq .Kind "post_create") (eq .Kind "post_action")]]// api-guidelines §7.2: header Idempotency-Key diteruskan ke use case (yang WAJIB idempoten terhadapnya).
func Test[[.Name]]_ForwardsIdempotencyKey(t *testing.T) {
	[[.Camel]]Restore(t)
	var got string
	[[if eq .Kind "post_create"]][[.Camel]]Func = func(_ context.Context, key string, _ [[.Name]]Request) ([[.Name]]Data, error) {
		got = key
		return [[.Name]]Data{ID: [[.Camel]]SampleID, Version: 1}, nil
	}[[else]][[.Camel]]Func = func(_ context.Context, id, _, key string, _ [[.Name]]Request) ([[.Name]]Data, error) {
		got = key
		return [[.Name]]Data{ID: id, Version: 2}, nil
	}[[end]]
	mux := http.NewServeMux()
	mux.Handle("[[.Method]] [[.Path]]", [[.Name]]())
	req := httptest.NewRequest("[[.Method]]", strings.ReplaceAll("[[.Path]]", "{id}", [[.Camel]]SampleID), strings.NewReader([[.Camel]]Body))
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Idempotency-Key", "kunci-123")
	mux.ServeHTTP(httptest.NewRecorder(), req)
	if got != "kunci-123" {
		t.Errorf("Idempotency-Key ke use case = %q, want kunci-123", got)
	}
}

