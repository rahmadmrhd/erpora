{
  "schema_version": "1",
  "key": "[[.Key]]",
  "slug": "[[.Slug]]",
  "name": "[[.Title]]",
  "version": "0.1.0",
  "publisher": { "id": "[[.Publisher]]", "name": "[[.PublisherName]]" },
  "trust": "builtin",
  "compatibility": { "platform": "^0.1", "sdk": "^0.1" },
  "dependencies": [
    { "module": "platform.core", "version": "^0.1", "optional": false }[[range .Dependencies]],
    { "module": "[[.Key]]", "version": "[[.Constraint]]", "optional": false }[[end]]
  ],
  "capabilities": [],
  "migrations": { "strategy": "versioned" },
  "i18n": { "locales": ["id", "en"], "defaultLocale": "id" },
  "offline": { "mode": "online-only" },
  "resources": [
    {
      "key": "[[.Slug]].items",
      "label": "resource.items",
      "actions": ["read"],
      "field_groups": [{ "key": "general", "label": "fieldGroup.general", "classification": "internal", "default": true }]
    }[[if .Metadata]],
    {
      "key": "[[.Slug]].item",
      "label": "resource.item",
      "actions": ["read"],
      "field_groups": [{ "key": "general", "label": "fieldGroup.general", "classification": "internal", "default": true }]
    }[[end]]
  ][[if .Frontend]],
  "desk": {
    "label": "desk.title",
    "icon": "boxes",
    "menus": [
      { "id": "items", "label": "nav.items", "to": "/items", "permission": "[[.Slug]].items.read" }
    ]
  }[[end]]
}
